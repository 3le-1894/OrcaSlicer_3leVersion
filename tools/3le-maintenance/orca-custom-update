#!/usr/bin/env bash
set -euo pipefail
source_dir=/home/elemental/Applications/OrcaCustom/worktrees/calculator-startup-integration
maintenance="$source_dir/tools/3le-maintenance"
dependency_prefix=/home/elemental/Documents/Codex/2026-10-21/you-are-orca-the-user-s/work/dual-nozzle-reliability/deps/build/OrcaSlicer_dep/usr/local
uv_executable=/home/elemental/Documents/Codex/2026-10-21/you-are-orca-the-user-s/outputs/SHOP-CALC-CONNECT-001-R3-BUILD/tools/uv
install_root=/home/elemental/Applications/OrcaCustom
mode=${1:-build}
[[ $# -eq 0 ]] || shift
case "$mode" in
build|deploy)
    [[ $# -eq 0 ]] || { echo 'Extra build flags disabled; dependency/config changes require review.' >&2; exit 1; }
    python3 -B "$maintenance/check_source.py"
    ;;
rollback) ;;
*) echo 'Usage: orca-custom-update [build|deploy|rollback BACKUP]' >&2; exit 1 ;;
esac
mkdir -p "$install_root/update-logs"
exec 9>"$install_root/update-logs/update.lock"
flock -n 9 || { echo 'Another Orca update is running.' >&2; exit 1; }
log="$install_root/update-logs/$(date +%Y%m%d-%H%M%S)-$$.log"
exec > >(tee -a "$log") 2>&1
restart_companion=0
recovery_backup=
finish() {
    local result=$?
    trap - EXIT
    if [[ -n "$recovery_backup" && ! -e "$install_root/runtime" ]]; then
        if ! mv "$recovery_backup" "$install_root/runtime"; then
            echo "Runtime restoration failed; backup is at $recovery_backup. Companion left stopped." >&2
            restart_companion=0
            result=1
        fi
    fi
    if [[ "$restart_companion" == 1 ]]; then
        echo 'Restarting Orca companion...'
        if ! systemctl --user start orca-companion.service; then
            echo 'Companion restart failed. Check: journalctl --user -u orca-companion.service -n 50' >&2
            result=1
        elif ! systemctl --user is-active --quiet orca-companion.service; then
            echo 'Companion did not become active.' >&2
            result=1
        fi
    fi
    exit "$result"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
validate_run() {
    # Rollback deliberately remains independent of source/build state.
    if [[ "$mode" == build || "$mode" == deploy ]]; then
        python3 -B "$maintenance/run_contract.py" staged "$run_record" "$package_seal" "$staged"
    fi
}
run_directory_build() {
    # Directory runtime only: never request the optional/downloading AppImage helper.
    "${sandbox[@]}" bash build_linux.sh -s -t -j "$jobs"
    [[ -d "$source_dir/build/package" ]] || { echo 'Directory runtime packaging produced no output.' >&2; return 1; }
}
prepare_companion() {
    local state answer
    state=$(systemctl --user show orca-companion.service --property=ActiveState --value)
    case "$state" in
    active)
        require_orca_closed
        echo 'Pause new slicing submissions and collect any completed async results.'
        echo 'The companion loses its in-memory async job records when restarted.'
        read -r -p 'Are all jobs finished and new submissions paused? Type yes: ' answer
        [[ "$answer" == yes ]] || { echo 'Deployment cancelled; companion left running.'; exit 1; }
        # Recheck after confirmation; never intentionally terminate an Orca process.
        require_orca_closed
        validate_run
        restart_companion=1
        echo 'Stopping Orca companion for runtime replacement...'
        systemctl --user stop orca-companion.service
        ;;
    inactive|failed) ;;
    *) echo "Companion is $state; retry after it settles." >&2; exit 1 ;;
    esac
    require_idle
}
require_idle() {
    # Activation requires a fully stopped companion and no running Orca binary.
    local state
    state=$(systemctl --user show orca-companion.service --property=ActiveState --value)
    [[ "$state" == inactive || "$state" == failed ]] || {
        echo 'Close Orca and, once companion jobs are finished, stop orca-companion.service before deploying.' >&2
        exit 1
    }
    require_orca_closed
}
require_orca_closed() {
    /home/elemental/.local/libexec/orca-close-windows --check
}
close_orca_windows() {
    /home/elemental/.local/libexec/orca-close-windows --close
}

case "$mode" in
build|deploy)
    run_record="${log%.log}.identity.json"
    package_seal="${log%.log}.package.json"
    # Captured AFTER lock acquisition; every later boundary must match it.
    python3 -B "$maintenance/run_contract.py" capture "$run_record" "$uv_executable"
    close_orca_windows
    cd "$source_dir"
    # Existing dependencies are explicit and read-only inside the build namespace.
    # No -d/-u, container bootstrap, network fetch or old native object reuse.
    export ORCA_EXTRA_BUILD_ARGS="-DCMAKE_PREFIX_PATH=$dependency_prefix -DPython3_ROOT_DIR=$dependency_prefix/libpython -DFETCHCONTENT_FULLY_DISCONNECTED=ON -DCMAKE_CXX_COMPILER=/usr/bin/c++ -DCMAKE_C_COMPILER=/usr/bin/cc -DORCA_BUNDLED_UV_EXECUTABLE=$uv_executable"
    export UV_OFFLINE=1
    jobs=${ORCA_BUILD_JOBS:-1}
    [[ "$jobs" =~ ^[1-4]$ ]] || { echo 'Use 1–4 build jobs; default is 1.' >&2; exit 1; }
    sandbox=(bwrap --clearenv --setenv PATH /usr/bin:/bin --setenv LANG C.UTF-8 --setenv HOME /tmp/orca-maintenance-home --setenv ORCA_EXTRA_BUILD_ARGS "$ORCA_EXTRA_BUILD_ARGS" --setenv UV_OFFLINE 1 --setenv CCACHE_DISABLE 1 --setenv CMAKE_BUILD_PARALLEL_LEVEL "$jobs" --unshare-net --ro-bind / / --bind "$source_dir" "$source_dir" --tmpfs /tmp --dev /dev --proc /proc --chdir "$source_dir")
    # Refuse stale directory outputs instead of accidentally blessing an older package.
    [[ ! -e "$source_dir/build/package" ]] || { echo 'Prior package exists; preserve it and arrange a reviewed fresh output before retrying.' >&2; exit 1; }
    run_directory_build
    python3 -B "$maintenance/run_contract.py" check "$run_record"
    regex='synced to the cloud|The build height check'
    "${sandbox[@]}" ctest --test-dir build -C Release --output-on-failure --no-tests=error -R "$regex"
    if [[ -f tests/libslic3r/test_shortest_path.cpp ]]; then
        # Fail closed if the travel patch is present but its registered tests are missing.
        "${sandbox[@]}" ctest --test-dir build -C Release --output-on-failure --no-tests=error -L '^TravelOptimization$'
    fi
    # Pure maintenance contracts first; actual native fixtures still require compilation.
    "${sandbox[@]}" python3 -B -m unittest discover -s "$maintenance/tests" -p 'test_*.py'
    "${sandbox[@]}" bash "$maintenance/tests/test_packaging.sh"
    contract_dir="$source_dir/build/maintenance-$(date +%Y%m%d-%H%M%S)-$$"
    mkdir "$contract_dir"
    "${sandbox[@]}" python3 -B "$maintenance/orca-print-calculator/reproduce.py" "$contract_dir/package"
    "${sandbox[@]}" cmake -S "$maintenance/native-fixtures" -B "$contract_dir/native" -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_COMPILER=/usr/bin/c++
    "${sandbox[@]}" cmake --build "$contract_dir/native" --parallel 1
    "${sandbox[@]}" ctest --test-dir "$contract_dir/native" --output-on-failure --no-tests=error
    python3 -B "$maintenance/run_contract.py" check "$run_record"
    package="$source_dir/build/package"
    python3 -B "$maintenance/run_contract.py" seal "$run_record" "$package" "$package_seal"
    [[ "$mode" == deploy ]] || { echo "Build/tests complete. Log: $log"; exit 0; }
    require_orca_closed
    package="$source_dir/build/package"
    for entry in orca-slicer bin/orca-slicer libexec/orca-slicer-env resources/profiles; do
        [[ -e "$package/$entry" ]] || { echo "Missing package component: $entry"; exit 1; }
    done
    stamp=$(date +%Y%m%d-%H%M%S)-$$
    staged="$install_root/runtime.staging-$stamp"
    backup="$install_root/runtime.backup-$stamp"
    mkdir "$staged"
    cp -a "$package/." "$staged/"
    python3 -B "$maintenance/run_contract.py" provenance "$run_record" "$package_seal" "$staged"
    validate_run
    # Stop only after build, tests and staging succeed.
    prepare_companion
    [[ -d "$install_root/runtime" && ! -L "$install_root/runtime" ]] || {
        echo 'Expected an existing runtime directory; activation aborted.'; exit 1;
    }
    validate_run
    recovery_backup="$backup"
    mv "$install_root/runtime" "$backup"
    if ! mv "$staged" "$install_root/runtime"; then
        mv "$backup" "$install_root/runtime"
        exit 1
    fi
    echo "Installed runtime. Previous runtime: $backup"
    echo "Rollback: $0 rollback '$backup'"
    restart_companion=1
    echo 'Runtime installed; the companion will now start automatically.'
    ;;
rollback)
    [[ $# -eq 1 ]] || { echo "Usage: $0 rollback /absolute/path/to/runtime.backup-TIMESTAMP"; exit 1; }
    backup=$1
    [[ "$backup" == "$install_root"/runtime.backup-* && -d "$backup" && ! -L "$backup" && -x "$backup/orca-slicer" ]] || {
        echo 'Invalid runtime backup.'; exit 1;
    }
    close_orca_windows
    prepare_companion
    displaced="$install_root/runtime.backup-before-rollback-$(date +%Y%m%d-%H%M%S)-$$"
    recovery_backup="$displaced"
    mv "$install_root/runtime" "$displaced"
    if ! mv "$backup" "$install_root/runtime"; then
        mv "$displaced" "$install_root/runtime"
        exit 1
    fi
    restart_companion=1
    echo "Restored runtime. Displaced runtime retained at: $displaced"
    ;;
*) echo "Usage: $0 [build|deploy|rollback BACKUP]"; exit 1 ;;
esac
